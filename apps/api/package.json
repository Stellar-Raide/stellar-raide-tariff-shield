{
  "name": "@stellar-raide-tariff-shield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/migrate.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:rollback": "tsx src/migrate.ts rollback",
    "test:integration": "node --import tsx/esm --test --test-reporter=junit --test-reporter-destination=test-results.xml src/__tests__/integration/*.test.ts",
    "benchmark": "bash tests/load/run-all.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 src",
    "lint:fix": "eslint --fix src",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@sentry/node": "^11.11.0",
    "@sentry/profiling-node": "^11.11.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "@stellar-raide-tariff-shield/sdk": "*",
    "bcryptjs": "^3.0.0",
    "bullmq": "^6.7.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "ioredis": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
